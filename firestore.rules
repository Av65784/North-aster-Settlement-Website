rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active == true;
    }

    function ownerProfileUpdate() {
      return ownsUserDoc(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'email',
          'createdAt',
          'role',
          'moderationNotes'
        ]);
    }

    match /adminUsers/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if ownsUserDoc(userId)
        && request.resource.data.xp == 0
        && request.resource.data.energy == 0
        && request.resource.data.totalScore == 0
        && (request.resource.data.role == 'user' || request.resource.data.role == 'admin');
      allow update: if isAdmin() || ownerProfileUpdate();
      allow delete: if false;

      match /subjects/{docId} {
        allow read, write: if ownsUserDoc(userId) || isAdmin();
      }

      match /units/{docId} {
        allow read, write: if ownsUserDoc(userId) || isAdmin();
      }

      match /subUnits/{docId} {
        allow read, write: if ownsUserDoc(userId) || isAdmin();
      }

      match /lessons/{docId} {
        allow read, write: if ownsUserDoc(userId) || isAdmin();
      }

      match /questions/{docId} {
        allow read, write: if ownsUserDoc(userId) || isAdmin();
      }

      match /answers/{docId} {
        allow read, write: if ownsUserDoc(userId) || isAdmin();
      }

      match /files/{docId} {
        allow read, write: if ownsUserDoc(userId) || isAdmin();
      }

      match /forgeSources/{docId} {
        allow read, write: if ownsUserDoc(userId) || isAdmin();
      }
    }

    match /classrooms/{classroomId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /classroomMembers/{memberId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /mockTests/{testId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /mockAssignments/{assignmentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /questionBank/{questionId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /xpTransactions/{transactionId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /energyTransactions/{transactionId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
