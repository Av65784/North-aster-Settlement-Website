# Firebase Configuration (Public - Safe to expose)
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# Razorpay (Public - Safe to expose)
VITE_RAZORPAY_KEY_ID="your-razorpay-key-id"

# NOTE: AI API keys are now stored securely in Firebase Cloud Functions environment variables
# Do NOT add GEMINI_API_KEY or any other AI keys here
# They will be exposed to the browser if prefixed with VITE_
